datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. IDENTITY & ACCESS MANAGEMENT
// ----------------------------------------------------

enum RoleType {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  phone           String         @unique
  passwordHash    String
  fullName        String
  avatarUrl       String?
  isActive        Boolean        @default(true)
  isPhoneVerified Boolean        @default(false)
  isEmailVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  userRoles       UserRole[]
  addresses       Address[]
  sellerProfile   SellerProfile?
  carts           Cart[]
  orders          Order[]
  bookings        Booking[]
  reviews         Review[]
  wishlists       Wishlist[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  auditLogs       AuditLog[]     @relation("ActorAuditLogs")

  @@index([phone])
  @@index([email])
}

model Role {
  id          String           @id @default(uuid())
  name        RoleType         @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id     String           @id @default(uuid())
  slug   String           @unique
  name   String
  module String
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ----------------------------------------------------
// 2. SELLER ECOSYSTEM & VERIFICATION
// ----------------------------------------------------

enum SellerStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  INDIVIDUAL_ARTISAN
  HOME_BASED
  REGISTERED_SOLE_PROPRIETOR
  PARTNERSHIP
  PRIVATE_LIMITED
  SELF_HELP_GROUP
}

model SellerProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  businessName      String
  slug              String             @unique
  businessType      BusinessType       @default(HOME_BASED)
  description       String?            @db.Text
  logoUrl           String?
  bannerUrl         String?
  status            SellerStatus       @default(DRAFT)
  rejectionReason   String?
  
  // Tax & Legal Info
  panNumber         String?
  gstin             String?
  
  // Bank Account & Settlement Details
  bankAccountNumber String?
  bankIfscCode      String?
  bankAccountName   String?
  bankName          String?

  ratingAverage     Decimal            @default(0.0) @db.Decimal(3, 2)
  totalRatings      Int                @default(0)
  totalOrders       Int                @default(0)
  isVerified        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         SellerDocument[]
  addresses         SellerAddress[]
  products          Product[]
  services          Service[]
  sellerOrders      SellerOrder[]
  transactions      Transaction[]
  settlements       SellerSettlement[]
  availabilities    ServiceAvailability[]

  @@index([status])
  @@index([slug])
}

enum DocumentType {
  AADHAAR_FRONT
  AADHAAR_BACK
  PAN_CARD
  BUSINESS_REGISTRATION
  CHEQUE_LEAF
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model SellerDocument {
  id           String             @id @default(uuid())
  sellerId     String
  documentType DocumentType
  documentUrl  String
  status       VerificationStatus @default(PENDING)
  notes        String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  seller       SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model SellerAddress {
  id           String        @id @default(uuid())
  sellerId     String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  latitude     Decimal?      @db.Decimal(10, 8)
  longitude    Decimal?      @db.Decimal(11, 8)
  isOperating  Boolean       @default(true)
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

// ----------------------------------------------------
// 3. PRODUCT MARKETPLACE
// ----------------------------------------------------

model ProductCategory {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  imageUrl     String?
  parentId     String?
  isActive     Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())

  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]

  @@index([slug])
}

enum ListingModerationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Product {
  id               String                  @id @default(uuid())
  sellerId         String
  categoryId       String
  name             String
  slug             String                  @unique
  description      String                  @db.Text
  highlights       String[]
  basePrice        Decimal                 @db.Decimal(10, 2)
  originalPrice    Decimal?                @db.Decimal(10, 2)
  sku              String?                 @unique
  isAvailable      Boolean                 @default(true)
  moderationStatus ListingModerationStatus @default(APPROVED)
  ratingAverage    Decimal                 @default(0.0) @db.Decimal(3, 2)
  totalRatings     Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  seller           SellerProfile           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category         ProductCategory         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    Wishlist[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([moderationStatus])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  imageUrl   String
  isPrimary  Boolean  @default(false)
  orderIndex Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  name          String
  sku           String?     @unique
  priceModifier Decimal     @default(0.0) @db.Decimal(10, 2)
  stockQuantity Int         @default(0)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  stockQuantity  Int      @default(0)
  lowStockAlert  Int      @default(5)
  allowBackorder Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 4. SERVICE MARKETPLACE
// ----------------------------------------------------

model ServiceCategory {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  imageUrl     String?
  parentId     String?
  isActive     Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())

  parent       ServiceCategory?  @relation("ServiceHierarchy", fields: [parentId], references: [id])
  children     ServiceCategory[] @relation("ServiceHierarchy")
  services     Service[]

  @@index([slug])
}

enum ServiceDeliveryMode {
  AT_CLIENT_LOCATION
  AT_SELLER_STUDIO
  ONLINE
}

model Service {
  id               String                  @id @default(uuid())
  sellerId         String
  categoryId       String
  name             String
  slug             String                  @unique
  description      String                  @db.Text
  price            Decimal                 @db.Decimal(10, 2)
  durationMinutes  Int                     @default(60)
  deliveryMode     ServiceDeliveryMode     @default(AT_CLIENT_LOCATION)
  serviceRadiusKm  Int?                    @default(15)
  advanceAmount    Decimal                 @default(0.0) @db.Decimal(10, 2)
  cancellationRule String?                 @db.Text
  isAvailable      Boolean                 @default(true)
  moderationStatus ListingModerationStatus @default(APPROVED)
  ratingAverage    Decimal                 @default(0.0) @db.Decimal(3, 2)
  totalRatings     Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  seller           SellerProfile           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category         ServiceCategory         @relation(fields: [categoryId], references: [id])
  portfolioImages  ServiceImage[]
  bookings         Booking[]
  reviews          Review[]
  wishlistItems    Wishlist[]

  @@index([sellerId])
  @@index([categoryId])
}

model ServiceImage {
  id         String   @id @default(uuid())
  serviceId  String
  imageUrl   String
  isPrimary  Boolean  @default(false)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAvailability {
  id            String        @id @default(uuid())
  sellerId      String
  dayOfWeek     Int           // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime     String        // "09:00"
  endTime       String        // "18:00"
  slotDuration  Int           @default(60)
  bufferMinutes Int           @default(15)
  isActive      Boolean       @default(true)
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, dayOfWeek])
}

// ----------------------------------------------------
// 5. CART & CHECKOUT
// ----------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  unitPrice Decimal         @db.Decimal(10, 2)
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
}

// ----------------------------------------------------
// 6. ORDERS & SUB-ORDERS (MULTI-VENDOR)
// ----------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  totalGross      Decimal       @db.Decimal(10, 2)
  totalDiscount   Decimal       @default(0.0) @db.Decimal(10, 2)
  totalShipping   Decimal       @default(0.0) @db.Decimal(10, 2)
  netPayable      Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING_PAYMENT)
  shippingAddress Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  sellerOrders    SellerOrder[]
  payments        Payment[]

  @@index([userId])
  @@index([orderNumber])
}

enum SellerOrderStatus {
  NEW
  ACCEPTED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model SellerOrder {
  id                String            @id @default(uuid())
  parentOrderId     String
  sellerId          String
  sellerOrderNumber String            @unique
  subTotal          Decimal           @db.Decimal(10, 2)
  shippingCharge    Decimal           @default(0.0) @db.Decimal(10, 2)
  platformFee       Decimal           @default(0.0) @db.Decimal(10, 2)
  sellerPayout      Decimal           @db.Decimal(10, 2)
  status            SellerOrderStatus @default(NEW)
  trackingNumber    String?
  courierPartner    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  parentOrder       Order             @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  seller            SellerProfile     @relation(fields: [sellerId], references: [id])
  items             OrderItem[]
  transactions      Transaction[]

  @@index([sellerId])
  @@index([parentOrderId])
  @@index([status])
}

model OrderItem {
  id            String          @id @default(uuid())
  sellerOrderId String
  productId     String
  variantId     String?
  quantity      Int
  unitPrice     Decimal         @db.Decimal(10, 2)
  totalPrice    Decimal         @db.Decimal(10, 2)
  sellerOrder   SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([sellerOrderId])
}

// ----------------------------------------------------
// 7. BOOKINGS & APPOINTMENTS
// ----------------------------------------------------

enum BookingStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  RESCHEDULE_REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

model Booking {
  id               String                 @id @default(uuid())
  bookingNumber    String                 @unique
  userId           String
  serviceId        String
  bookingDate      DateTime               @db.Date
  startTime        String
  endTime          String
  totalPrice       Decimal                @db.Decimal(10, 2)
  advancePaid      Decimal                @default(0.0) @db.Decimal(10, 2)
  platformFee      Decimal                @default(0.0) @db.Decimal(10, 2)
  sellerPayout     Decimal                @db.Decimal(10, 2)
  status           BookingStatus          @default(CONFIRMED)
  serviceAddress   Json?
  specialNotes     String?
  cancellationNote String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id])
  service          Service                @relation(fields: [serviceId], references: [id])
  statusHistory    BookingStatusHistory[]
  payments         Payment[]
  transactions     Transaction[]

  @@unique([serviceId, bookingDate, startTime])
  @@index([userId])
  @@index([serviceId])
  @@index([bookingDate])
  @@index([status])
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  oldStatus BookingStatus
  newStatus BookingStatus
  changedBy String
  reason    String?
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ----------------------------------------------------
// 8. PAYMENTS, COMMISSIONS & DOUBLE-ENTRY LEDGER
// ----------------------------------------------------

enum PaymentGateway {
  RAZORPAY
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id               String         @id @default(uuid())
  parentOrderId    String?
  bookingId        String?
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayOrderId   String?        @unique
  gatewayPaymentId String?        @unique
  gatewaySignature String?
  status           PaymentStatus  @default(INITIATED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  parentOrder      Order?         @relation(fields: [parentOrderId], references: [id])
  booking          Booking?       @relation(fields: [bookingId], references: [id])
  refunds          Refund[]

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  amount          Decimal  @db.Decimal(10, 2)
  gatewayRefundId String?  @unique
  reason          String?
  status          String   @default("PROCESSED")
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id])
}

enum CommissionType {
  PERCENTAGE
  FLAT_FEE
}

enum MarketVertical {
  PRODUCT
  SERVICE
}

model CommissionRule {
  id         String         @id @default(uuid())
  vertical   MarketVertical
  categoryId String?
  type       CommissionType @default(PERCENTAGE)
  value      Decimal        @db.Decimal(5, 2)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
}

enum TransactionType {
  SALE_CREDIT
  COMMISSION_DEBIT
  PAYMENT_GATEWAY_FEE
  REFUND_DEBIT
  SETTLEMENT_PAYOUT
}

model Transaction {
  id            String            @id @default(uuid())
  sellerId      String
  sellerOrderId String?
  bookingId     String?
  settlementId  String?
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  balanceAfter  Decimal           @db.Decimal(10, 2)
  description   String
  createdAt     DateTime          @default(now())

  seller        SellerProfile     @relation(fields: [sellerId], references: [id])
  sellerOrder   SellerOrder?      @relation(fields: [sellerOrderId], references: [id])
  booking       Booking?          @relation(fields: [bookingId], references: [id])
  settlement    SellerSettlement? @relation(fields: [settlementId], references: [id])

  @@index([sellerId])
  @@index([type])
}

enum SettlementStatus {
  PENDING
  PROCESSING
  TRANSFERRED
  FAILED
}

model SellerSettlement {
  id            String           @id @default(uuid())
  sellerId      String
  settlementRef String           @unique
  grossAmount   Decimal          @db.Decimal(10, 2)
  deductions    Decimal          @db.Decimal(10, 2)
  netAmount     Decimal          @db.Decimal(10, 2)
  status        SettlementStatus @default(PENDING)
  bankUtrNumber String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())

  seller        SellerProfile    @relation(fields: [sellerId], references: [id])
  transactions  Transaction[]

  @@index([sellerId])
  @@index([status])
}

// ----------------------------------------------------
// 9. ADDRESSES, REVIEWS, WISHLIST & SYSTEM
// ----------------------------------------------------

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  type         AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id          String   @id @default(uuid())
  userId      String
  productId   String?
  serviceId   String?
  rating      Int
  comment     String?  @db.Text
  sellerReply String?  @db.Text
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([serviceId])
  @@index([userId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  serviceId String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, serviceId])
}

model Coupon {
  id           String   @id @default(uuid())
  code         String   @unique
  discountPct  Decimal? @db.Decimal(5, 2)
  flatDiscount Decimal? @db.Decimal(10, 2)
  minSpend     Decimal  @default(0.0) @db.Decimal(10, 2)
  maxDiscount  Decimal? @db.Decimal(10, 2)
  validUntil   DateTime
  usageLimit   Int      @default(1000)
  usedCount    Int      @default(0)
  isActive     Boolean  @default(true)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SupportTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  userId       String
  subject      String
  status       String   @default("OPEN")
  priority     String   @default("MEDIUM")
  message      String   @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
}
