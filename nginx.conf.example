# ==============================================================================
# Nginx Configuration for mahilo.sriddha.com (Isolated to port 5093)
# Place in: /etc/nginx/sites-available/mahilo.sriddha.com
# Symlink: ln -s /etc/nginx/sites-available/mahilo.sriddha.com /etc/nginx/sites-enabled/
# Test & Reload: sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

server {
    listen 80;
    server_name mahilo.sriddha.com;

    # Client upload size limit
    client_max_body_size 25M;

    location / {
        # Strictly reverse proxy to isolated port 5093
        proxy_pass http://127.0.0.1:5093;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
